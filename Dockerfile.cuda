# CUDA + TensorRT execution provider build.
# This image is linux/amd64 only — no ARM GPU instance types exist.
# Requires NVIDIA Container Toolkit on the host / ECS GPU AMI.

# ── Builder stage ─────────────────────────────────────────────────────────────
# Use the CUDA devel image so nvcc and CUDA headers are present at build time.
FROM nvidia/cuda:12.6.0-cudnn-devel-ubuntu24.04 AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       curl ca-certificates build-essential pkg-config libssl-dev python3 \
    && rm -rf /var/lib/apt/lists/*

# Download rustup-init, verify the official SHA-256 sidecar, then install.
ARG RUSTUP_VERSION=1.29.0
RUN BASE="https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu" \
    && curl --proto '=https' --tlsv1.2 -sSf "${BASE}/rustup-init"        -o /tmp/rustup-init \
    && curl --proto '=https' --tlsv1.2 -sSf "${BASE}/rustup-init.sha256"  -o /tmp/rustup-init.sha256 \
    && cd /tmp && sha256sum -c rustup-init.sha256 \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --default-toolchain stable \
    && rm /tmp/rustup-init /tmp/rustup-init.sha256
ENV PATH="/root/.cargo/bin:${PATH}"

# Download the pinned ORT prebuilt for CUDA + TensorRT, verify SHA-256, then extract.
#
# IMPORTANT — pyke.io artifact selection (corrected after the 2026-05 codekeeper outage):
# The previous build used the "nvrtx" feature artifact. Inspection of that archive
# (`x86_64-unknown-linux-gnu+nvrtx.tar.lzma2`) showed it contains ONLY:
#   - libonnxruntime.a
#   - libonnxruntime_providers_shared.so
#   - libonnxruntime_providers_nv_tensorrt_rtx.so   <-- new "NvTensorRtRtx" EP
# It does NOT contain `libonnxruntime_providers_tensorrt.so`, the standard
# `TensorrtExecutionProvider` EP that our Rust code requests via
# `ort::ep::TensorRT`. With that .so missing at runtime, ORT silently falls
# back to MLAS/CPU when our code asks for TensorRT, no engines are written
# to `{BGE_M3_CACHE_DIR}/trt-engines/`, and `session.run()` keeps returning
# `Ok(_)` because CPU inference works fine. That was the entire 2026-05
# silent-persistence failure mode.
#
# The "cu12" feature artifact contains BOTH EPs (verified by extracting the
# tarball and listing contents):
#   - libonnxruntime.a
#   - libonnxruntime_providers_cuda.so
#   - libonnxruntime_providers_nv_tensorrt_rtx.so
#   - libonnxruntime_providers_shared.so
#   - libonnxruntime_providers_tensorrt.so          <-- the EP we actually need
# Checksum taken from ort-sys-2.0.0-rc.12/build/download/dist.txt (feature set "cu12").
# Same lzma2 FORMAT_RAW extraction as the CPU Dockerfile (no XZ container).
ARG ORT_VERSION=1.24.2
ARG ORT_CU12_URL=https://cdn.pyke.io/0/pyke:ort-rs/ms@1.24.2/x86_64-unknown-linux-gnu+cu12.tar.lzma2
ARG ORT_CU12_SHA256=6e7848acdb7284feb44e2781583a90e820839767459ad8fa2abf7dd63b731fd9
RUN curl --proto '=https' --tlsv1.2 -sSfL "$ORT_CU12_URL" -o /tmp/ort.tar.lzma2 \
    && echo "${ORT_CU12_SHA256}  /tmp/ort.tar.lzma2" | sha256sum -c - \
    && python3 -c "import lzma, tarfile, io, os; data = open('/tmp/ort.tar.lzma2', 'rb').read(); dec = lzma.decompress(data, format=lzma.FORMAT_RAW, filters=[{'id': lzma.FILTER_LZMA2, 'dict_size': 1<<26}]); os.makedirs('/opt/ort', exist_ok=True); tf = tarfile.open(fileobj=io.BytesIO(dec)); tf.extractall('/opt/ort', filter='data'); tf.close()" \
    && rm /tmp/ort.tar.lzma2
ENV ORT_LIB_LOCATION=/opt/ort

WORKDIR /app

# Cache dependency compilation by building a dummy binary first.
# benches/ stubs are required for all [[bench]] targets because Cargo validates
# source paths at manifest parse time, even though cargo build --release skips
# bench compilation.
COPY Cargo.toml Cargo.lock build.rs ./
RUN mkdir src && echo "fn main(){}" > src/main.rs && touch src/lib.rs \
    && mkdir -p benches/coreml && touch benches/embeddings.rs benches/coreml/main.rs \
    && cargo build --release --features cuda,tensorrt \
    && rm -rf src benches

COPY src ./src
COPY benches ./benches
RUN touch src/main.rs && cargo build --release --features cuda,tensorrt

# ── Runtime stage ──────────────────────────────────────────────────────────────
# Only the CUDA runtime libs are needed at inference time — not the full devel
# image (no nvcc, no headers, no static libraries).
FROM nvidia/cuda:12.6.0-cudnn-runtime-ubuntu24.04

# Install the TensorRT 10 runtime libraries that
# `libonnxruntime_providers_tensorrt.so` `dlopen`s at runtime.
#
# The pyke.io ORT prebuilt links against `libnvinfer.so.10`, `libnvinfer_plugin.so.10`,
# and `libnvonnxparser.so.10` (per `nm`/`strings` on `libonnxruntime_providers_tensorrt.so`).
# Without these, ORT's TRT EP registration would fail loudly at startup
# (now that `error_on_failure` is set on the dispatch in `session.rs`).
# NVIDIA's CUDA APT repo carries them as `libnvinfer-dispatch10`,
# `libnvinfer-plugin10`, and `libnvonnxparsers10` for Ubuntu 24.04 x86_64.
#
# Note: we deliberately do NOT install `libnvinfer-headers-dev` or `libnvinfer-bin`
# — those are devel/builder-side. Only the runtime `.so`s are needed here.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl libssl3t64 \
       libnvinfer10 libnvinfer-plugin10 libnvonnxparsers10 \
    && rm -rf /var/lib/apt/lists/*

# UID/GID must match EFS model-cache access point in Codekeeper CDK (10002).
RUN groupadd --gid 10002 bge \
    && useradd --uid 10002 --gid bge --no-create-home --shell /sbin/nologin bge

# Copy the ORT provider shared libraries from the builder, placed NEXT TO
# the binary in `/usr/local/bin/`. This is required for the static-linked
# ORT case, and `LD_LIBRARY_PATH`/`ldconfig` *cannot* fix it. Detail below.
#
# `libonnxruntime.a` is statically linked into the binary; the per-EP
# factories live in dynamically-loaded shared libraries that ORT `dlopen`s
# on first registration. ORT's `provider_bridge_ort.cc::ProviderLibrary::Load`
# computes the dlopen path as
#
#     full_path = Env::Default().GetRuntimePath() + filename;
#
# where `GetRuntimePath` is implemented in `core/platform/posix/env.cc`:
#
#     dladdr(&Env::Default, &dl_info);
#     auto p = std::filesystem::path{dl_info.dli_fname};
#     return std::filesystem::absolute(p).remove_filename();
#
# When ORT is statically linked, `dladdr` returns
# `dl_info.dli_fname == argv[0]` (glibc 2.39 on Ubuntu 24.04 uses argv[0],
# NOT `AT_EXECFN`, for the main executable's `dli_fname`).
#
# This means:
#   * If argv[0] is RELATIVE (e.g. `CMD ["bge-m3-embedding-server"]` →
#     argv[0]="bge-m3-embedding-server"), `absolute()` resolves it against
#     the process's cwd. With the default Docker cwd of `/`, the runtime
#     path is `/`, and ORT tries to dlopen
#     `/libonnxruntime_providers_shared.so` — an absolute path that does not
#     exist and which `dlopen` will NOT search via `LD_LIBRARY_PATH` or
#     `ld.so.cache` (because per `dlopen(3)`, any `/` in the filename forces
#     pathname interpretation). That was the 2026-05 root cause.
#   * If argv[0] is ABSOLUTE (`CMD ["/usr/local/bin/bge-m3-embedding-server"]`),
#     `dli_fname` is absolute, `remove_filename()` returns `/usr/local/bin/`,
#     and ORT looks for providers there — independent of cwd.
#
# Fix: place provider `.so` files in `/usr/local/bin/` next to the binary,
# AND invoke the binary by absolute path in `CMD`. This is cwd-invariant
# and works regardless of how the container is started (ECS, k8s, plain
# `docker run`, `docker exec`, etc.).
COPY --from=builder /opt/ort/libonnxruntime_providers_shared.so /usr/local/bin/
COPY --from=builder /opt/ort/libonnxruntime_providers_tensorrt.so /usr/local/bin/
COPY --from=builder /opt/ort/libonnxruntime_providers_cuda.so /usr/local/bin/

COPY --from=builder /app/target/release/bge-m3-embedding-server /usr/local/bin/
USER bge

HEALTHCHECK --interval=10s --timeout=3s --start-period=120s --retries=3 \
    CMD curl --fail --silent http://localhost:8081/health || exit 1

EXPOSE 8081
# Absolute path is REQUIRED. See the comment above the COPY block —
# argv[0] must be absolute so ORT's `dladdr`-based provider lookup
# produces `/usr/local/bin/` as the runtime path.
CMD ["/usr/local/bin/bge-m3-embedding-server"]
